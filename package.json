{
  "name": "sunoapp",
  "version": "1.0.11",
  "description": "Application Windows non officielle pour utiliser Suno avec un lecteur personnalisé, un mini-lecteur et des contrôles multimédias",
  "author": "Flora Cherry",
  "homepage": "https://github.com/HanaCherry/SunoApp",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder --win nsis"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "com.flora.sunoapp",
    "productName": "SunoApp",
    "win": {
      "target": "nsis",
      "icon": "icone_flora.ico"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "sunoapp-main-a.js",
      "sunoapp-main-b.js",
      "mini-preload.js",
      "mini-player.html",
      "sunoapp-i18n.js",
      "sunoapp-i18n-1.js",
      "sunoapp-i18n-2.js",
      "sunoapp-i18n-3.js",
      "sunoapp-i18n-4.js",
      "sunoapp-i18n-5.js",
      "sunoapp-i18n-6.js",
      "sunoapp-i18n-7.js",
      "sunoapp-i18n-8.js",
      "sunoapp-i18n-9.js",
      "sunoapp-i18n-10.js",
      "sunoapp-i18n-11.js",
      "sunoapp-i18n-12.js",
      "sunoapp-i18n-13.js",
      "spectrum.html",
      "spectrum-preload.js",
      "main-enhancements.js",
      "sunoapp-enh-2.js",
      "sunoapp-enh-3.js",
      "sunoapp-enh-3b.js",
      "sunoapp-enh-4.js",
      "sunoapp-enh-5.js",
      "sunoapp-enh-6.js",
      "package.json",
      "icone_flora.ico",
      "like.png",
      "prec.png",
      "play.png",
      "pause.png",
      "stop.png",
      "suiv.png",
      "mini.png",
      "startup.mp3"
    ],
    "extraMetadata": {
      "name": "sunoapp",
      "version": "1.0.11"
    }
  }
}
