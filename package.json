{
  "name": "sunoapp",
  "version": "1.0.18",
  "description": "Application de bureau non officielle pour Suno, avec thèmes et contrôles multimédias",
  "author": "SunoApp Maintainers",
  "homepage": "https://github.com/HanaCherry/SunoApp",
  "main": "main.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "prestart": "node scripts/build-i18n.cjs",
    "prebuild": "node scripts/build-i18n.cjs",
    "predist": "node scripts/build-i18n.cjs",
    "start": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder --win nsis",
    "dist:win": "npm run prebuild && electron-builder --win nsis --x64 --publish never",
    "dist:linux": "npm run prebuild && electron-builder --linux AppImage deb --x64 --publish never",
    "dist:mac": "npm run prebuild && electron-builder --mac dmg zip --x64 --arm64 --publish never"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "electron": "^42.11.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.sunoapp.desktop",
    "productName": "SunoApp",
    "win": {
      "target": "nsis",
      "icon": "app-icon.ico"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "sunoapp-security.js",
      "sunoapp-site-language.js",
      "sunoapp-theme.js",
      "sunoapp-i18n-browser.js",
      "sunoapp-main-a.js",
      "sunoapp-main-b.js",
      "mini-preload.js",
      "mini-player.html",
      "sunoapp-i18n.js",
      "sunoapp-i18n-1.js",
      "sunoapp-i18n-2.js",
      "sunoapp-i18n-3.js",
      "sunoapp-i18n-4.js",
      "sunoapp-i18n-5.js",
      "sunoapp-i18n-6.js",
      "sunoapp-i18n-7.js",
      "sunoapp-i18n-8.js",
      "sunoapp-i18n-9.js",
      "sunoapp-i18n-10.js",
      "sunoapp-i18n-11.js",
      "sunoapp-i18n-12.js",
      "sunoapp-i18n-13.js",
      "spectrum.html",
      "spectrum-preload.js",
      "main-enhancements.js",
      "sunoapp-enh-2.js",
      "sunoapp-enh-3.js",
      "sunoapp-enh-3b.js",
      "sunoapp-enh-4.js",
      "sunoapp-enh-5.js",
      "sunoapp-enh-6.js",
      "package.json",
      "app-icon.ico",
      "like.png",
      "prec.png",
      "play.png",
      "pause.png",
      "stop.png",
      "suiv.png",
      "mini.png",
      "startup.mp3",
      "LICENSE",
      "app-icon.png"
    ],
    "extraMetadata": {
      "name": "sunoapp",
      "version": "1.0.18"
    },
    "artifactName": "SunoApp-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "app-icon.png",
      "category": "AudioVideo",
      "maintainer": "SunoApp Maintainers <213934282+HanaCherry@users.noreply.github.com>"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "app-icon.icns",
      "category": "public.app-category.music",
      "identity": null
    }
  },
  "license": "SEE LICENSE IN LICENSE"
}
