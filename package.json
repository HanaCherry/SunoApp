{
  "name": "sunoapp",
  "version": "1.0.2",
  "description": "Application Electron pour accéder à Suno.com avec contrôles multimédias",
  "author": "Flora Cherry",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder --win nsis"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "com.flora.sunoapp",
    "productName": "SunoApp",
    "win": {
      "target": "nsis",
      "icon": "icone_flora.ico"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json",
      "icone_flora.ico",
      "like.png",
      "prec.png",
      "play.png",
      "pause.png",
      "stop.png",
      "suiv.png",
      "mini.png",
      "startup.mp3"
    ],
    "extraMetadata": {
      "name": "sunoapp",
      "version": "1.0.2"
    }
  }
}
